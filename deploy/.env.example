# Copy to /opt/hesta/.env on the VPS and fill in. Never commit the real file.
DATASOURCE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DATASOURCE_USERNAME=
DATASOURCE_PASSWORD=
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
MQTT_USERNAME=
MQTT_PASSWORD=
INTERNAL_API_KEY=
HESTA_ML_SERVICE_API_KEY=
REDIS_PASSWORD=
CORS_ALLOWED_ORIGINS=https://hesta.homes,https://www.hesta.homes
FRONTEND_URL=https://hesta.homes
HESTA_OTA_PUBLIC_BASE_URL=https://hesta.homes

# /opt/hesta/.env.recommendation (recommendation-service):
