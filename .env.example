# Copy this file to .env and fill in your values.
# DO NOT commit .env to Git!

# Database Configuration (Supabase Cloud - ask team lead for credentials)
DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATASOURCE_USERNAME=postgres.your_project_ref
DATASOURCE_PASSWORD=your_database_password

# Google OAuth 2.0 (ask team lead for credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary (ask team lead for credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail SMTP - ask team lead for credentials)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
