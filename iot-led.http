### ====================================================================
### 0.1 Check Device Detail & Current State
### ====================================================================
#GET {{baseUrl}}/api/v1/devices/{{deviceId}}
#Authorization: Bearer {{token}}
#
#### ====================================================================
#### 1. POWER_ON Command
#### ====================================================================
#POST {{baseUrl}}/api/devices/{{deviceId}}/command
#Content-Type: application/json
##Authorization: Bearer {{token}}
#
#{
#  "action": "POWER_ON"
#}

### ====================================================================
### 2. POWER_OFF Command
### ====================================================================
POST {{baseUrl}}/api/devices/{{deviceId}}/command
Content-Type: application/json
#Authorization: Bearer {{token}}

{
  "action": "POWER_OFF"
}

### ====================================================================
### 3. SET_RGB Command (RED)
### ====================================================================
POST {{baseUrl}}/api/devices/{{deviceId}}/command
Content-Type: application/json
#Authorization: Bearer {{token}}

{
  "action": "SET_RGB",
  "r": 255,
  "g": 0,
  "b": 0
}

### ====================================================================
### 4. SET_RGB Command (GREEN)
### ====================================================================
POST {{baseUrl}}/api/devices/{{deviceId}}/command
Content-Type: application/json
#Authorization: Bearer {{token}}

{
  "action": "SET_RGB",
  "r": 0,
  "g": 255,
  "b": 0
}

### ====================================================================
### 5. SET_RGB Command (BLUE)
### ====================================================================
POST {{baseUrl}}/api/devices/{{deviceId}}/command
Content-Type: application/json
#Authorization: Bearer {{token}}

{
  "action": "SET_RGB",
  "r": 0,
  "g": 0,
  "b": 255
}

### ====================================================================
### 6. SET_BRIGHTNESS Command (50%)
### ====================================================================
POST {{baseUrl}}/api/devices/{{deviceId}}/command
Content-Type: application/json
#Authorization: Bearer {{token}}

{
  "action": "SET_BRIGHTNESS",
  "brightness": 50
}

### ====================================================================
### 7. Invalid RGB (r: 300 -> Expected: HTTP 400)
### ====================================================================
POST {{baseUrl}}/api/devices/{{deviceId}}/command
Content-Type: application/json
#Authorization: Bearer {{token}}

{
  "action": "SET_RGB",
  "r": 300,
  "g": 0,
  "b": 0
}

### ====================================================================
### 8. Invalid Brightness (brightness: 150 -> Expected: HTTP 400)
### ====================================================================
POST {{baseUrl}}/api/devices/{{deviceId}}/command
Content-Type: application/json
#Authorization: Bearer {{token}}

{
  "action": "SET_BRIGHTNESS",
  "brightness": 150
}

### ====================================================================
### 9. Invalid Action (UNKNOWN_ACTION -> Expected: HTTP 400)
### ====================================================================
POST {{baseUrl}}/api/devices/{{deviceId}}/command
Content-Type: application/json
#Authorization: Bearer {{token}}

{
  "action": "UNKNOWN_ACTION"
}

