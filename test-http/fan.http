### ====================================================================
### HESTA Smart Home - Quạt Thông Minh (Smart Fan) Test Suite
### ====================================================================
### Cấu hình thiết bị theo ESP32 Fan_Motor.ino:
### - Node ID:   664017ce-c045-4b0e-9a26-f9f95f996803
### - Device ID: f0000000-0000-4000-8000-000000000104
### - MQTT Topics:
###   + Lệnh (Subscribe):     hesta/nodes/{{nodeId}}/devices/{{deviceId}}/command
###   + Trạng thái (Publish): hesta/nodes/{{nodeId}}/devices/{{deviceId}}/state
###   + Xác nhận (ACK):       hesta/nodes/{{nodeId}}/devices/{{deviceId}}/ack
### ====================================================================

@baseUrl = http://localhost:8080
@deviceId = 6643cf42-bb8e-434e-a440-743afe06c457
@nodeId = 109441d8-b6bf-4a18-bdf8-9279b7a1548d
#@token = 

### ====================================================================
### 0. (Optional) Login to obtain JWT Bearer token if authentication is enabled
### ====================================================================
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "test@gmail.com",
  "password": "123123123"
}

> {%
    if (response.body && response.body.result && response.body.result.accessToken) {
        client.global.set("token", response.body.result.accessToken);
    }
%}

### ====================================================================
### 0.1 Xem thông tin & trạng thái hiện tại của Quạt
### ====================================================================
GET {{baseUrl}}/api/v1/devices/{{deviceId}}
Authorization: Bearer {{token}}

### ====================================================================
### 1. BẬT QUẠT (Action: TURN_ON)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "TURN_ON",
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 2. TẮT QUẠT (Action: TURN_OFF)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "TURN_OFF",
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 3. BẬT QUẠT (Action: POWER_ON)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "POWER_ON",
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 4. TẮT QUẠT (Action: POWER_OFF)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "POWER_OFF",
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 5. CÀI ĐẶT NGUỒN QUẠT (SET_POWER: power = true)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_POWER",
  "power": true,
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 6. CÀI ĐẶT NGUỒN QUẠT (SET_POWER: power = false)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_POWER",
  "power": false,
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 7. CÀI ĐẶT TỐC ĐỘ QUẠT MỨC 1 (SET_SPEED: speed = 1 - Thấp / LOW)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_SPEED",
  "speed": 1,
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 8. CÀI ĐẶT TỐC ĐỘ QUẠT MỨC 2 (SET_SPEED: speed = 2 - Trung bình / MED)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_SPEED",
  "speed": 2,
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 9. CÀI ĐẶT TỐC ĐỘ QUẠT MỨC 3 (SET_SPEED: speed = 3 - Cao / HIGH)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_SPEED",
  "speed": 3,
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 10. CÀI ĐẶT TỐC ĐỘ QUẠT QUA SET_FAN (MỨC 1 / LOW)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_FAN",
  "fan": 1,
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 11. CÀI ĐẶT TỐC ĐỘ QUẠT QUA SET_FAN (MỨC 2 / MED)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_FAN",
  "fan": 2,
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 12. CÀI ĐẶT TỐC ĐỘ QUẠT QUA SET_FAN (MỨC 3 / HIGH)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_FAN",
  "fan": "HIGH",
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 13. TẮT QUẠT QUA SET_FAN (fan: OFF hoặc speed: 0)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_FAN",
  "fan": "OFF",
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 14. GỬI LỆNH TRỰC TIẾP QUA TARGET (target: "fan", power: true)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "target": "fan",
  "power": true,
  "nodeId": "{{nodeId}}"
}

### ====================================================================
### 15. LỊCH SỬ THAY ĐỔI TRẠNG THÁI CỦA QUẠT
### ====================================================================
GET {{baseUrl}}/api/v1/devices/{{deviceId}}/history
Authorization: Bearer {{token}}
