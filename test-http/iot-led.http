### HESTA Smart Home - Device Command API Test Suite
### ====================================================================

@baseUrl = http://localhost:8080
@deviceId = f803473e-8f7f-4dcd-8001-5ce1fc2f4dc4
#@nodeId = 32442d7f-dfcf-4b2f-a380-adba32876cec
@nodeId = 109441d8-b6bf-4a18-bdf8-9279b7a1548d
@led1Id = 19f79c42-afc1-4796-a48c-8d076ea45b65
@led2Id = 98ae5452-250c-44c6-8b1a-fac08b2fc716
@led3Id = c8186ca5-ff09-486c-bc56-ac75ef85e6d9
@led4Id = c968b5c4-80d1-4aec-abef-cc52876a6da5
@led5Id = b016fe3d-36fc-4d3e-a8bd-e287d7138395
@gateId = 2d566d0a-f7d6-4fac-a0bf-18912da4ab28
@doorId = c77b64a6-e163-44eb-83d2-431de5eb8f43
#@token =

### 0. (Optional) Login to obtain JWT Bearer token if authentication is enabled
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "test@gmail.com",
  "password": "123123123"
}

> {%
    if (response.body && response.body.result && response.body.result.accessToken) {
        client.global.set("token", response.body.result.accessToken);
    }
%}

### ====================================================================
### 0.1 Check Device Detail & Current State
### ====================================================================
#GET {{baseUrl}}/api/v1/devices/{{deviceId}}
Authorization: Bearer {{token}}
#
#### ====================================================================
#### 1. POWER_ON Command
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "POWER_ON"
}

### ====================================================================
### 2. POWER_OFF Command
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "POWER_OFF"
}

### ====================================================================
### 3. SET_RGB Command (RED)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_RGB",
  "r": 255,
  "g": 0,
  "b": 0
}

### ====================================================================
### 4. SET_RGB Command (GREEN)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_RGB",
  "r": 0,
  "g": 255,
  "b": 0
}

### ====================================================================
### 5. SET_RGB Command (BLUE)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_RGB",
  "r": 0,
  "g": 0,
  "b": 255
}

### ====================================================================
### 6. SET_BRIGHTNESS Command (50%)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_BRIGHTNESS",
  "brightness": 50
}

### ====================================================================
### 7. Invalid RGB (r: 300 -> Expected: HTTP 400)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_RGB",
  "r": 300,
  "g": 0,
  "b": 0
}

### ====================================================================
### 8. Invalid Brightness (brightness: 150 -> Expected: HTTP 400)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_BRIGHTNESS",
  "brightness": 150
}

### ====================================================================
### 9. Invalid Action (UNKNOWN_ACTION -> Expected: HTTP 400)
### ====================================================================
POST {{baseUrl}}/api/v1/devices/{{deviceId}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "UNKNOWN_ACTION"
}

