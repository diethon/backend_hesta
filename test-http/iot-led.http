### ====================================================================
### 11. ESP32 4CH LED - LED 1 (19f79c42-afc1-4796-a48c-8d076ea45b65)
### ====================================================================
### 11.1 LED 1 - POWER_ON
POST {{baseUrl}}/api/v1/devices/{{led5Id}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "POWER_ON"
}

### 11.2 LED 1 - SET_BRIGHTNESS (80%)
POST {{baseUrl}}/api/v1/devices/{{led1Id}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "SET_BRIGHTNESS",
  "brightness": 80
}

### 11.3 LED 1 - INCREASE_BRIGHTNESS (+20%)
POST {{baseUrl}}/api/v1/devices/{{led1Id}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "INCREASE_BRIGHTNESS",
  "amount": 20
}

### 11.4 LED 1 - DECREASE_BRIGHTNESS (-20%)
POST {{baseUrl}}/api/v1/devices/{{led1Id}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "DECREASE_BRIGHTNESS",
  "amount": 20
}

### 11.5 LED 1 - TOGGLE
POST {{baseUrl}}/api/v1/devices/{{led5Id}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "TOGGLE"
}

### 11.6 LED 1 - POWER_OFF
POST {{baseUrl}}/api/v1/devices/{{led4Id}}/command
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "POWER_OFF"
}

