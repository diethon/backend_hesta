# ==============================================================================
# HESTA EDGE AI - CẤU HÌNH NGUỒN CAMERA & HỆ THỐNG
# ==============================================================================
# HƯỚNG DẪN DÀNH CHO BẠN (CHUYỂN ĐỔI CHẾ ĐỘ CAMERA):
#
# 1. HÔM NAY (DEMO CHIỀU NAY VỚI KHÁCH BẰNG WEBCAM LAPTOP):
#    HESTA_CAMERA_MODE=WEBCAM
#    HESTA_WEBCAM_INDEX=0
#
# 2. TUẦN SAU (KHI CAMERA IP IMOU / EZVIZ VỀ ĐỂ BÀN GIAO CHO KHÁCH):
#    HESTA_CAMERA_MODE=IP_CAMERA
#    HESTA_RTSP_URL=rtsp://admin:PASS_DUOI_DICH_CAM@192.168.1.168:554/cam/realmonitor?channel=1&subtype=0
# ==============================================================================

# CHẾ ĐỘ CAMERA: "WEBCAM" HOẶC "IP_CAMERA"
HESTA_CAMERA_MODE=WEBCAM

# CHỈ SỐ WEBCAM (0: Webcam tích hợp mặc định trên laptop)
HESTA_WEBCAM_INDEX=0

# ĐƯỜNG DẪN RTSP CAMERA IP THẬT (KHI CAM VỀ TUẦN SAU)
# - Dòng Imou: rtsp://admin:<PASSWORD_DUOI_DAY_CAM>@<IP>:554/cam/realmonitor?channel=1&subtype=0
# - Dòng Ezviz: rtsp://admin:<VERIFICATION_CODE_6_CHU_IN_HOA>@<IP>:554/h264Preview_01_main
HESTA_RTSP_URL=rtsp://admin:Hesta@2026@192.168.1.168:554/cam/realmonitor?channel=1&subtype=0

# THÔNG TIN MQTT & HỆ THỐNG HESTA
HESTA_MQTT_HOST=localhost
HESTA_MQTT_PORT=1883
HESTA_DEVICE_ID=cam_livingroom_01
