# Voice Service Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to Git!

# Shared secret API key — must match the value configured in Spring Boot
# Ask the Java team lead for the actual value
INTERNAL_API_KEY=your_internal_api_key_here

# Spring Boot backend base URL
# Use localhost if voice-service runs on same machine as Spring Boot
# Use LAN IP if running on different machines (e.g., Pi -> dev machine)
BACKEND_BASE_URL=http://localhost:8080
